NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY from `supabase status -o env`>

# Trace ingest (/api/otel/v1/traces) works out who sent each trace from the
# reviewer's personal trace token (x-rma-trace-token header), created at /review/trace-tokens.
# Server only, never NEXT_PUBLIC_: ingest looks up tokens and stores spans with it, bypassing RLS.
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY from `supabase status -o env`>
# Optional: save every accepted trace request body here (see lib/otel/__fixtures__/README.md).
# RMA_TRACE_CAPTURE_DIR=/tmp/rma-traces

# hCaptcha's official test keys (always pass)
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
HCAPTCHA_SECRET_KEY=0x0000000000000000000000000000000000000000