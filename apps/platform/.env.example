NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY from `supabase status -o env`>

# Trace ingest (/api/otel/v1/traces): the one token accepted until personal trace
# tokens exist. Agents send it as the x-rma-token header.
RMA_DEV_TRACE_TOKEN=dev-trace-token

# hCaptcha's official test keys (always pass)
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
HCAPTCHA_SECRET_KEY=0x0000000000000000000000000000000000000000