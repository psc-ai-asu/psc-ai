# Claude API key from https://platform.claude.com (API keys page)
ANTHROPIC_API_KEY=
# Optional: defaults to claude-haiku-5-5
# ANTHROPIC_MODEL=claude-sonnet-5-5

# LangChain / LangGraph -> OpenTelemetry (no LangSmith account needed)
LANGSMITH_TRACING=true
LANGSMITH_OTEL_ENABLED=true
LANGSMITH_OTEL_ONLY=true

# Where traces go: the platform's ingest route (run `npm run dev` in apps/platform).
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:3001/api/otel/v1/traces
# Your trace token and the agent's id on the platform. The token below matches
# RMA_DEV_TRACE_TOKEN in apps/platform/.env.example; the id is the seeded Course Planner.
OTEL_EXPORTER_OTLP_HEADERS=x-rma-token=dev-trace-token,x-rma-agent-id=a0000000-0000-0000-0000-000000000004
OTEL_SERVICE_NAME=course-planner

# The Anthropic SDK would otherwise send its own duplicate spans for every model call.
ANTHROPIC_OPEN_TELEMETRY=false
